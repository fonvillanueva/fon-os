# ─── PUBLIC CONFIGURATION ─────────────────────────────────────────────────────
#
# Vite inlines every VITE_-prefixed variable into the browser bundle. Only put
# values here that are safe for anyone to read in page source.
#
# The anon key is one of those: it is a public identifier, and it grants nothing
# on its own because every table has RLS enabled and forced with no policies.
# Phase 4 adds the policies that decide what a signed-in person may see.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key-from-supabase-dashboard>"

# ─── SERVER-ONLY SECRETS ──────────────────────────────────────────────────────
#
# NEVER give any of these a VITE_ prefix, and never read them from code under
# src/. Doing so publishes them in the JavaScript bundle to anyone who opens
# the page. They belong in Vercel's environment variables (server scope) or in
# a local .env that git ignores.
#
# The service-role key BYPASSES Row Level Security entirely — it reads and
# writes every task regardless of policy. Treat it like a password to the whole
# board. It is not needed at all in Phase 3.

SUPABASE_SERVICE_ROLE_KEY="<server-only — never prefixed with VITE_>"
SUPABASE_DB_URL="postgresql://<user>:<password>@<host>:5432/postgres"

# Phase 5 only. Pong authenticates to our own API with this; our API then talks
# to Supabase. Pong never holds a Supabase key.
PONG_API_TOKEN="<server-only — generated in Phase 5>"
